{
  "system": "memsys-v0",
  "write_after": "session",
  "consolidation_cadence": "nightly",
  "consolidation_time": "03:00",
  "consolidation_min_sessions": 1,
  "consolidation_style": "small_edits",
  "profile_cap_words": 300,
  "description_limit_chars": 150,
  "recent_window_sessions": 10,
  "file_picker": "answer_model",
  "file_organization": "claude_apps",
  "write_threshold": "recurs_or_remember",
  "stale_values": "inline_previously",
  "inference_policy": "inferred_non_sensitive",
  "models": {"write": "claude-haiku-5-5", "dream": "claude-haiku-5-5", "answer": "claude-sonnet-5-5"},
  "effort": {"write": "medium", "dream": "medium", "answer": "medium"},
  "max_tokens": {"write": 8000, "dream": 16000, "answer": 8000},
  "max_tool_hops": {"write": 8, "dream": 12, "answer": 6},
  "archive_search": {"max_sessions": 5, "snippets_per_session": 3, "snippet_chars": 300},
  "prompts": {"write": "../prompts/write.md", "dream": "../prompts/dream.md", "answer": "../prompts/answer.md"}
}
